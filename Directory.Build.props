<?xml version="1.0" encoding="utf-8"?>
<Project>
  
  <!-- Propriétés globales pour tous les projets -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Configuration platform-spécifique -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' OR '$(PlatformTarget)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86' OR '$(PlatformTarget)' == 'x86' OR '$(Platform)' == 'Win32'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <!-- Par défaut: x64 -->
  <PropertyGroup Condition="'$(PlatformTarget)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
